From 5ee6a396cfb87c7b6588ad96083233032980e639 Mon Sep 17 00:00:00 2001
From: bill <84451962+bill997@users.noreply.github.com>
Date: Thu, 15 May 2025 10:03:45 +1000
Subject: [PATCH] Fix compatibility with protobuf v30 (cpp 6.30.0) (#2869)

Similar to gazebosim/gz-msgs#499.

Signed-off-by: bill ross <4451962+bill997@users.noreply.github.com>
Co-authored-by: bill ross <4451962+bill997@users.noreply.github.com>
Co-authored-by: Steve Peters <scpeters@openrobotics.org>
---
 src/systems/log/LogRecord.cc                          | 2 +-
 src/systems/triggered_publisher/TriggeredPublisher.cc | 3 ++-
 2 files changed, 3 insertions(+), 2 deletions(-)

diff --git src/systems/log/LogRecord.cc src/systems/log/LogRecord.cc
index 3361c407f4..6e7d20120a 100644
--- src/systems/log/LogRecord.cc
+++ src/systems/log/LogRecord.cc
@@ -298,7 +298,7 @@ bool LogRecordPrivate::Start(const std::string &_logPath,
   if (!validSdfTopic.empty())
   {
     this->sdfPub = this->node.Advertise(validSdfTopic,
-        this->sdfMsg.GetTypeName());
+        std::string(this->sdfMsg.GetTypeName()));
   }
   else
   {
diff --git src/systems/triggered_publisher/TriggeredPublisher.cc src/systems/triggered_publisher/TriggeredPublisher.cc
index 58f4a73b87..830668744a 100644
--- src/systems/triggered_publisher/TriggeredPublisher.cc
+++ src/systems/triggered_publisher/TriggeredPublisher.cc
@@ -575,7 +575,8 @@ void TriggeredPublisher::Configure(const Entity &,
       if (nullptr != info.msgData)
       {
         info.pub =
-            this->node.Advertise(info.topic, info.msgData->GetTypeName());
+            this->node.Advertise(info.topic,
+                std::string(info.msgData->GetTypeName()));
         if (info.pub.Valid())
         {
           this->outputInfo.push_back(std::move(info));
